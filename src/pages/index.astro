---
import Logo from "../components/Logo.astro";
import "../styles/global.css";
import { technologies } from "../data/technologies";
import { onDark, onLight } from "../utils/contrast";
import { monogram } from "../utils/monogram";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="dark light" />
        <meta
            name="theme-color"
            content="#121212"
            media="(prefers-color-scheme: dark)"
        />
        <meta
            name="theme-color"
            content="#ffffff"
            media="(prefers-color-scheme: light)"
        />
        <title>Max van der Wolf</title>
    </head>
    <body>
        <header class="flex flex-wrap items-center gap-6">
            <Logo class="h-40 w-40 shrink-0" />
            <h1 class="m-0">Hoi, ik ben Max 👋</h1>
        </header>
        <p>
            Een evaren software developer met interesse in full-stack
            development, AI en DevOps. Energie uit het bouwen van toepassingen
            die mensen daadwerkelijk gebruiken, het behalen van concrete
            resultaten en het oplossen van technische problemen. Analytisch,
            kritisch en zelfstandig.
        </p>
        <h2>Technologieën, talen en frameworks</h2>
        <p>Dit zijn een paar van de dingen die ik ken</p>
        <div class="relative mt-6">
            <label class="sr-only" for="tech-search">
                Zoek in technologieën
            </label>
            <svg
                class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-muted"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
            </svg>
            <input
                id="tech-search"
                type="search"
                placeholder="Zoek technologie waar ik evaring in heb…"
                autocomplete="off"
                spellcheck="false"
                class="w-full rounded-xl border border-line bg-surface py-2.5 pr-4 pl-10 text-sm text-body transition placeholder:text-muted focus-visible:border-line-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-symbol"
            />
        </div>
        <p id="tech-status" role="status" class="mt-3 text-sm text-muted"></p>
        <ul
            id="tech-list"
            class="mt-6 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
        >
            {technologies.map((tech) => {
                // TODO: add URLs for tech
                const Tag = tech.url ? "a" : "div";
                return (
                    <li data-name={tech.name.toLowerCase()}>
                        <Tag
                            href={tech.url}
                            target={tech.url ? "_blank" : undefined}
                            rel={tech.url ? "noopener noreferrer" : undefined}
                            class="group flex h-full flex-col items-center justify-center gap-2 rounded-xl border border-line bg-surface p-3 text-center text-body no-underline transition hover:border-line-hover hover:bg-surface-hover hover:text-symbol focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-symbol"
                        >
                            {tech.path ? (
                                <svg
                                    viewBox="0 0 24 24"
                                    class="tech-icon h-8 w-8 shrink-0"
                                    style={`--icon-on-dark: ${onDark(tech.hex)}; --icon-on-light: ${onLight(tech.hex)}`}
                                    aria-hidden="true"
                                >
                                    <path d={tech.path} />
                                </svg>
                            ) : (
                                <span
                                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-hover text-xs font-semibold text-muted"
                                    aria-hidden="true"
                                >
                                    {monogram(tech.name)}
                                </span>
                            )}
                            <span class="text-xs font-medium leading-tight">
                                {tech.name}
                            </span>
                        </Tag>
                    </li>
                );
            })}
        </ul>
        <div
            id="tech-more"
            class="mt-6 flex flex-wrap items-center justify-center gap-3"
            hidden
        >
            <p id="tech-more-label" class="m-0 text-sm text-muted">
                en nog <span id="tech-more-count">0</span> meer
            </p>
            <button
                id="tech-show-all"
                type="button"
                class="rounded-xl border border-line bg-surface px-4 py-2 text-sm font-medium text-body transition hover:border-line-hover hover:bg-surface-hover hover:text-symbol focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-symbol"
            >
                Alles tonen
            </button>
            <button
                id="tech-show-less"
                type="button"
                class="rounded-xl border border-line bg-surface px-4 py-2 text-sm font-medium text-body transition hover:border-line-hover hover:bg-surface-hover hover:text-symbol focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-symbol"
                hidden
            >
                Minder tonen
            </button>
        </div>

        <h2>Persoonlijke projecten</h2>
        <p></p>
        <h2>Opleidingen</h2>
        <p></p>
        <h2>Werk evaring</h2>
        <p>Ik heb bij deze bedrijven gewerkt:</p>
        <ul class="mt-3 list-disc space-y-2 pl-6">
            <li>
                <strong>2023–2024 — Software Developer</strong>
                <br />
                Ministerie van Financiën, Den Haag
                <br />
                <a href="https://www.linkedin.com/in/marvinalibahadoer">
                    Contact mijn oude werkgever
                </a>
            </li>
            <li>
                <strong>2022–2023 — DevOps</strong>
                <br />
                Gemeente Rotterdam, Rotterdam
                <br />
                <a href="https://www.linkedin.com/in/eddievisser/">
                    Contact mijn oude werkgever
                </a>
            </li>
        </ul>
        <script>
            const input = document.getElementById("tech-search");
            const list = document.getElementById("tech-list");
            const status = document.getElementById("tech-status");
            const more = document.getElementById("tech-more");
            const moreLabel = document.getElementById("tech-more-label");
            const moreCount = document.getElementById("tech-more-count");
            const showAll = document.getElementById("tech-show-all");
            const showLess = document.getElementById("tech-show-less");
            const LIMIT = 18;

            const items = Array.from(list.querySelectorAll("li"));
            const total = items.length;
            let expanded = false;

            const render = () => {
                const raw = input.value.trim();
                const query = raw.toLowerCase();
                const filtering = query.length > 0;
                let matches = 0;

                for (const item of items) {
                    const hit = (item.dataset.name || "").includes(query);
                    item.hidden = !hit;
                    if (hit) matches++;
                }

                const capped = !filtering && !expanded;
                if (capped) {
                    let shown = 0;
                    for (const item of items) {
                        if (!item.hidden && ++shown > LIMIT) item.hidden = true;
                    }
                }

                const remaining = capped ? Math.max(0, matches - LIMIT) : 0;
                const collapsible = expanded && !filtering;
                more.hidden = remaining === 0 && !collapsible;
                moreLabel.hidden = collapsible;
                showAll.hidden = collapsible;
                showLess.hidden = !collapsible;
                moreCount.textContent = String(remaining);

                status.textContent = !filtering
                    ? ""
                    : matches === 0
                      ? `Geen technologieën gevonden voor “${raw}”.`
                      : `${matches} van ${total} technologieën`;
            };

            showAll.addEventListener("click", () => {
                expanded = true;
                render();
            });

            showLess.addEventListener("click", () => {
                expanded = false;
                render();
            });

            input.addEventListener("input", render);
            render();
        </script>
    </body>
</html>
