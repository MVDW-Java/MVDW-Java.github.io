---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/profile";

const featured = projects.filter((project) => project.featured);
---

<BaseLayout title="Max van der Wolf - Fullstack developer & product thinker">
    <section>
        <h1>Hoi, ik ben Max 👋</h1>
        <p class="mt-4 text-lg font-medium text-symbol">
            Software developer met interesse in full-stack development, AI en
            DevOps.
        </p>
        <p>
            Energie uit het bouwen van toepassingen die mensen daadwerkelijk
            gebruiken, het behalen van concrete resultaten en het oplossen van
            technische problemen. Analytisch, kritisch en zelfstandig.
        </p>
        <div class="mt-6 text-center">
            <a class="btn-primary" href="/projecten/">
                Bekijk mijn projecten
            </a>
        </div>
    </section>

    <section>
        <h2>Wat ik doe</h2>
        <div class="mt-4 grid gap-4 md:grid-rows-3">
            <article class="card">
                <h3 class="mt-0">Fullstack development</h3>
                <p class="m-0">
                    Van frontend tot backend maak ik webapplicaties met talen
                    zoals JavaScript, TypeScript, Go, PHP en Python en ze dan
                    live brengen met Docker, Cloudflare en Linux.
                </p>
            </article>
            <article class="card">
                <h3 class="mt-0">AI & nieuwe technologie</h3>
                <p class="m-0">
                    Ik experimenteer met AI modellen en tooling zoals Ollama,
                    PyTorch en Llamacpp en zoek altijd naar nieuwe technologieën
                    om uit te proberen.
                </p>
            </article>
            <article class="card">
                <h3 class="mt-0">UX/UI & productdenken</h3>
                <p class="m-0">
                    Creatief met het bedenken van nieuwe ideen, en deze dan ook
                    echt programmeren. Ik kijk wat gebruikers willen en hoe ik
                    dit kan maken.
                </p>
            </article>
        </div>
    </section>

    <section>
        <h2>Een paar persoonlijke projecten</h2>
        <p>
            Sinds dat ik 11 jaar oud was ben ik aan het programmeren, en heb een
            par projecten draaien:
        </p>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
            {featured.map((project) => (
                <article class="card">
                    <h3 class="mt-0">{project.name}</h3>
                    <p class="m-0 text-sm text-muted">
                        {project.period} · {project.tagline}
                    </p>
                    <p class="mt-3">{project.description.split(".")[0]}.</p>
                    {project.liveUrl && (
                        <p class="mt-3">
                            <a
                                href={project.liveUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Bekijk site
                            </a>
                        </p>
                    )}
                </article>
            ))}
        </div>
        <p class="mt-6">
            <a href="/projecten/">Alle projecten bekijken →</a>
        </p>
    </section>
</BaseLayout>
