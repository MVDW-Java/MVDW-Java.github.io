---
import Logo from "../components/Logo.astro";
import "../styles/global.css";
import { technologies } from "../data/technologies";
import { onDark, onLight } from "../utils/contrast";
import { monogram } from "../utils/monogram";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="dark light" />
        <meta
            name="theme-color"
            content="#121212"
            media="(prefers-color-scheme: dark)"
        />
        <meta
            name="theme-color"
            content="#ffffff"
            media="(prefers-color-scheme: light)"
        />
        <title>Max van der Wolf</title>
    </head>
    <body>
        <header class="flex flex-wrap items-center gap-6">
            <Logo class="h-40 w-40 shrink-0" />
            <h1 class="m-0">Hoi, ik ben Max 👋</h1>
        </header>
        <p>
            Een evaren software developer met interesse in full-stack
            development, AI en DevOps. Energie uit het bouwen van toepassingen
            die mensen daadwerkelijk gebruiken, het behalen van concrete
            resultaten en het oplossen van technische problemen. Analytisch,
            kritisch en zelfstandig.
        </p>
        <h2>Technologieën en talen</h2>
        <p>Dit zijn een paar van de dingen die ik ken</p>
        <div class="relative mt-6">
            <label class="sr-only" for="tech-search">
                Zoek in technologieën
            </label>
            <svg
                class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-muted"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
            </svg>
            <input
                id="tech-search"
                type="search"
                placeholder="Zoek technologie waar ik evaring in heb…"
                autocomplete="off"
                spellcheck="false"
                class="w-full rounded-xl border border-line bg-surface py-2.5 pr-4 pl-10 text-sm text-body transition placeholder:text-muted focus-visible:border-line-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-symbol"
            />
        </div>
        <p id="tech-status" role="status" class="mt-3 text-sm text-muted"></p>
        <ul
            id="tech-list"
            class="mt-6 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
        >
            {technologies.map((tech) => {
                // TODO: add URLs for tech
                const Tag = tech.url ? "a" : "div";
                return (
                    <li data-name={tech.name.toLowerCase()}>
                        <Tag
                            href={tech.url}
                            target={tech.url ? "_blank" : undefined}
                            rel={tech.url ? "noopener noreferrer" : undefined}
                            class="group flex h-full flex-col items-center justify-center gap-2 rounded-xl border border-line bg-surface p-3 text-center text-body no-underline transition hover:border-line-hover hover:bg-surface-hover hover:text-symbol focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-symbol"
                        >
                            {tech.path ? (
                                <svg
                                    viewBox="0 0 24 24"
                                    class="tech-icon h-8 w-8 shrink-0"
                                    style={`--icon-on-dark: ${onDark(tech.hex)}; --icon-on-light: ${onLight(tech.hex)}`}
                                    aria-hidden="true"
                                >
                                    <path d={tech.path} />
                                </svg>
                            ) : (
                                <span
                                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-hover text-xs font-semibold text-muted"
                                    aria-hidden="true"
                                >
                                    {monogram(tech.name)}
                                </span>
                            )}
                            <span class="text-xs font-medium leading-tight">
                                {tech.name}
                            </span>
                        </Tag>
                    </li>
                );
            })}
        </ul>
        <h2>Persoonlijke projecten</h2>
        <p></p>
        <h2>Opleidingen</h2>
        <p></p>
        <h2>Werk evaring</h2>
        <p>Ik heb bij deze bedrijven gewerkt:</p>
        <ul class="mt-3 list-disc space-y-2 pl-6">
            <li>
                <strong>2023–2024 — Software Developer</strong>
                <br />
                Ministerie van Financiën, Den Haag
                <br />
                <a href="https://nl.linkedin.com/in/marvinalibahadoer">
                    Contact mijn baas
                </a>
            </li>
            <li>
                <strong>2022–2023 — DevOps</strong>
                <br />
                Gemeente Rotterdam, Rotterdam
                <br />
                <a href="mailto:">Contact mij baas</a>
            </li>
        </ul>
        <script>
            const input = document.getElementById("tech-search");
            const list = document.getElementById("tech-list");
            const status = document.getElementById("tech-status");

            if (input instanceof HTMLInputElement && list && status) {
                const items = Array.from(list.querySelectorAll("li"));
                const total = items.length;

                const update = () => {
                    const query = input.value.trim().toLowerCase();
                    let matches = 0;

                    for (const item of items) {
                        const hit = (item.dataset.name ?? "").includes(query);
                        item.hidden = !hit;
                        if (hit) matches++;
                    }

                    status.textContent = !query
                        ? ""
                        : matches === 0
                          ? `Geen technologieën gevonden voor “${input.value.trim()}”.`
                          : `${matches} van ${total} technologieën`;
                };

                input.addEventListener("input", update);
            }
        </script>
    </body>
</html>
