---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact - Max van der Wolf">
    <h1>Contact</h1>
    <p>
        Ben je werkgever of wil je wat vragen? Ik ben te berijken via een van
        onderstaande links.
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
        <article class="card">
            <h2 class="mt-0 text-base">E-mail</h2>
            <p class="m-0 text-sm">
                <a href="mailto:maxvdwolf@gmail.com">maxvdwolf@gmail.com</a>
            </p>
        </article>
        <article class="card">
            <h2 class="mt-0 text-base">GitHub</h2>
            <p class="m-0 text-sm">
                <a
                    href="https://github.com/MVDW-Java"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    github.com/MVDW-Java
                </a>
            </p>
        </article>
        <article class="card">
            <h2 class="mt-0 text-base">LinkedIn</h2>
            <p class="m-0 text-sm">
                <a
                    href="https://www.linkedin.com/in/max-van-der-wolf-234781180/"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    linkedin.com/in/max-van-der-wolf-234781180/
                </a>
            </p>
        </article>
    </div>
</BaseLayout>
